<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jianjian.ai.zksh.report.mapper.ReportInterpretationMapper">

    <resultMap id="ReportInterpretationResultMap" type="com.jianjian.ai.zksh.report.domain.entity.ReportInterpretationEntity">
        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="summary" property="summary"/>
        <result column="structured_json" property="structuredJson"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.jianjian.ai.zksh.report.domain.entity.ReportInterpretationEntity"
            useGeneratedKeys="true" keyProperty="id">
        insert into report_interpretation(task_id, summary, structured_json, created_at)
        values (#{taskId}, #{summary}, #{structuredJson}, now())
    </insert>

    <select id="selectByTaskId" resultMap="ReportInterpretationResultMap">
        select id, task_id, summary, structured_json, created_at
        from report_interpretation
        where task_id = #{taskId}
        order by id desc
        limit 1
    </select>
</mapper>

